<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.gymNotice">

    <resultMap id="gymNoticeMap" type="dto.gym.GymNotice">
        <id property="id" column="id"/>
        <result property="gymId" column="gym_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="title" column="title"/>
        <result property="content" column="text"/>
        <result property="viewCount" column="view_count"/>
    </resultMap>

	<!-- 메인페이지용 최근 공지 4개 -->
    <select id="selectRecentNoticeByGym" parameterType="int" resultMap="gymNoticeMap">
        SELECT
            id,
            gym_id,
            title,
            `text`,
            created_at,
            view_count
        FROM GYM_NOTICE
        WHERE gym_id = #{value}
        ORDER BY created_at DESC
        LIMIT 4
    </select>
    
    <!-- 공지 총 개수 -->
    <select id="selectNoticeCount" parameterType="int" resultType="int">
		SELECT COUNT(*)
		FROM GYM_NOTICE
		WHERE gym_id = #{gymId}
	</select>
	
	<!-- 공지 목록 조회 (페이지 처리 + 정렬) -->
	<select id="selectNoticeList" parameterType="map" resultMap="gymNoticeMap">
		SELECT
            id,
            gym_id,
            title,
            `text`,
            created_at,
            view_count
        FROM GYM_NOTICE
        WHERE gym_id = #{gymId}
        <choose>
        	<when test="sort == 'view'">
        		ORDER BY view_count DESC, created_at DESC
        	</when>
        	<otherwise>
        		ORDER BY created_at DESC
        	</otherwise>
        </choose>
        LIMIT #{pageSize} OFFSET #{offset}
	</select>
	
	<!-- 공지 상세 -->
	<select id="selectNoticeDetail" parameterType="int" resultMap="gymNoticeMap">
		SELECT
            id,
            gym_id,
            title,
            `text`,
            created_at,
            view_count
        FROM GYM_NOTICE
        WHERE id = #{value}
	</select>
	
	<!-- 조회수 증가 -->
	<update id="updateViewCount" parameterType="int">
		UPDATE GYM_NOTICE
		SET view_count = view_count + 1
		WHERE id = #{value}
	</update>
	
	<!-- 공지 등록 -->
	<insert id="insertNotice" parameterType="dto.gym.GymNotice">
		INSERT INTO GYM_NOTICE (
            gym_id,
            title,
            `text`,
            view_count,
            created_at
        )
        VALUES (
            #{gymId},
            #{title},
            #{content},
            0,
            NOW()
        )
	</insert>
	
</mapper>