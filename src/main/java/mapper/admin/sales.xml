<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.admin.sales">
    <!-- [1] 결제 및 매출 분석용 ResultMap -->
    <resultMap id="PaymentResultMap" type="sales">
        <id property="paymentNum" column="id"/> <!-- PAYMENT 테이블의 id -->
        <result property="paymentDate" column="payment_date"/>
        <result property="paymentPrice" column="payment_price"/>
        <result property="paymentFee" column="payment_fee"/>
        <result property="paymentStatus" column="status"/>
        <result property="userNum" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="method" column="method"/>
        <result property="canceledAt" column="canceled_at"/>
        <result property="reason" column="reason"/>
        <result property="tossPaymentKey" column="toss_payment_key"/>
        <result property="tossOrderId" column="toss_order_id"/>
        <!-- 조인 필드 -->
        <result property="gymId" column="gym_id"/>
        <result property="gymName" column="gym_name"/>
        <result property="trainerId" column="trainer_id"/>
        <result property="trainerName" column="trainer_name"/>
    </resultMap>

    <!-- [2] 정산 전용 ResultMap -->
    <resultMap id="SettlementResultMap" type="sales">
        <id property="settlementNum" column="id"/> <!-- SETTLEMENT 테이블의 id -->
        <result property="targetNum" column="target_id"/>
        <result property="targetType" column="target_type"/>
        <result property="settlementMonth" column="settlement_month"/>
        <result property="settlementDeadline" column="settlement_deadline"/>
        <result property="totalSales" column="total_sales"/>
        <result property="totalFee" column="total_fee"/>
        <result property="netAmount" column="net_amount"/>
        <result property="settlementStatus" column="status"/> <!-- 컬럼명이 status인 경우 -->
        <result property="completedAt" column="completed_at"/>
    </resultMap>

    <!-- [섹션 1] 정산 상세 내역 조회 (SettlementResultMap 사용) -->
    <select id="selectSettlementList" resultMap="SettlementResultMap">
        SELECT * FROM SETTLEMENT
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="searchKeyword != null and searchKeyword != ''">
                AND (target_id LIKE CONCAT('%', #{searchKeyword}, '%')) 
            </if>
        </where>
        ORDER BY settlement_deadline ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- [섹션 2] 매출 상세 내역 조회 (PaymentResultMap 사용) -->
    <select id="selectSalesList" resultMap="PaymentResultMap">
        SELECT 
            p.id, p.payment_date, p.payment_price, p.payment_fee,
            p.gym_id, g.gym_name, 
            p.trainer_id, t.trainer_name
        FROM PAYMENT p
        LEFT JOIN GYM g ON p.gym_id = g.gym_id
        LEFT JOIN TRAINER t ON p.trainer_id = t.trainer_id
        WHERE p.status = '결제완료'
        <if test="startDate != null and endDate != null">
            AND p.payment_date BETWEEN #{startDate} AND #{endDate}
        </if>
        ORDER BY p.payment_date DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- [섹션 3] 결제 내역 조회 (PaymentResultMap 사용) -->
    <select id="selectPaymentHistory" resultMap="PaymentResultMap">
        SELECT * FROM PAYMENT
        <where>
            <if test="status != null and status != '전체'">
                AND status = #{status}
            </if>
            <if test="searchKeyword != null and searchKeyword != ''">
                AND (user_id LIKE CONCAT('%', #{searchKeyword}, '%') OR toss_order_id LIKE CONCAT('%', #{searchKeyword}, '%'))
            </if>
        </where>
        ORDER BY payment_date DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- [추가] 대시보드 요약 -->
    <select id="getSalesSummary" resultType="map">
        SELECT 
            IFNULL(SUM(payment_price), 0) as totalSales,
            IFNULL(SUM(payment_fee), 0) as totalFee,
            IFNULL(SUM(payment_price) - SUM(payment_fee), 0) as netProfit
        FROM PAYMENT
        WHERE status = '결제완료' 
        <if test="startDate != null and endDate != null">
            AND payment_date BETWEEN #{startDate} AND #{endDate}
        </if>
    </select>
    
    <!-- [추가] 정산 상태 업데이트 -->
    <update id="updateSettlementStatus">
        UPDATE SETTLEMENT 
        SET status = '정산완료', 
            completed_at = NOW() 
        WHERE id = #{id}
    </update>
</mapper>