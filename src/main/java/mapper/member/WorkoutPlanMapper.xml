<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.WorkoutPlanMapper">

    <resultMap id="planResultMap" type="WorkoutPlanDTO">
        <id     property="email"     column="email"/>
        <result property="goal"      column="goal"/>
        <result property="level"     column="level"/>
        <result property="height"    column="height"/>
        <result property="weight"    column="weight"/>
        <result property="diet"      column="diet"/>
        <result property="frequency" column="frequency"/>
    </resultMap>

    <!-- ──────────────────────────────────────────────────────
         WorkoutPlanDAOImpl.getPlan(String email)
         MyPageDAOImpl.selectWorkoutPlan(String email)
         → param: string
         ────────────────────────────────────────────────────── -->
    <select id="getPlan" parameterType="string" resultMap="planResultMap">
        SELECT email, goal, level, height, weight, diet, frequency
        FROM workout_plan
        WHERE email = #{email}
    </select>

    <!-- ──────────────────────────────────────────────────────
         WorkoutPlanDAOImpl.savePlan(WorkoutPlanDTO plan)
         → param: WorkoutPlanDTO  (UPSERT)
         ────────────────────────────────────────────────────── -->
    <insert id="savePlan" parameterType="WorkoutPlanDTO">
        INSERT INTO workout_plan (email, goal, level, height, weight, diet, frequency)
        VALUES (#{email}, #{goal}, #{level}, #{height}, #{weight}, #{diet}, #{frequency})
        ON DUPLICATE KEY UPDATE
            goal      = #{goal},
            level     = #{level},
            height    = #{height},
            weight    = #{weight},
            diet      = #{diet},
            frequency = #{frequency}
    </insert>

    <!-- ──────────────────────────────────────────────────────
         WorkoutPlanDAOImpl.update(WorkoutPlanDTO dto)
         MyPageDAOImpl.updateWorkoutPlan(WorkoutPlanDTO plan)
         → param: WorkoutPlanDTO
         ────────────────────────────────────────────────────── -->
    <update id="update" parameterType="WorkoutPlanDTO">
        UPDATE workout_plan
        SET goal      = #{goal},
            level     = #{level},
            height    = #{height},
            weight    = #{weight},
            diet      = #{diet},
            frequency = #{frequency}
        WHERE email   = #{email}
    </update>

</mapper>