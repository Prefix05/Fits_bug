<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.CommunityMapper">

    <!-- =====================================================
         CommunityDTO 매핑
         ===================================================== -->
    <resultMap id="communityResultMap" type="dto.member.CommunityDTO">
        <id     property="id"          column="id"/>
        <result property="userEmail"   column="user_id"/>
        <result property="category"    column="category"/>
        <result property="title"       column="title"/>
        <result property="content"     column="content"/>
        <result property="image"       column="image"/>
        <result property="hashtags"    column="hashtags"/>
        <result property="createdAt"   column="created_at"/>

        <result property="likeCount"   column="like_count"/>
        <result property="goodCount"   column="good_count"/>
        <result property="muscleCount" column="muscle_count"/>
    </resultMap>


    <!-- =====================================================
         CommunityDAOImpl.selectAll()
         ===================================================== -->
    <select id="selectAll" resultMap="communityResultMap">
        SELECT
            id,
            user_id,
            category,
            title,
            content,
            image,
            hashtags,
            created_at,
            like_count,
            good_count,
            muscle_count
        FROM v_post_summary
        ORDER BY total_score DESC
    </select>


    <!-- =====================================================
         CommunityDAOImpl.selectById(int id)
         ===================================================== -->
    <select id="selectById" parameterType="int" resultMap="communityResultMap">
        SELECT
            id,
            user_id,
            category,
            title,
            content,
            image,
            hashtags,
            created_at,
            like_count,
            good_count,
            muscle_count
        FROM v_post_summary
        WHERE id = #{id}
    </select>

</mapper>