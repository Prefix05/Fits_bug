<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.PaymentMapper">

    <!--
        PAYMENT 테이블 컬럼:
        id, user_id, user_name, membership_id, mr_id, gym_id, trainer_id,
        payment_date, payment_price, payment_fee, method,
        status, payment_type, canceled_at, reason

        수정: 이전 orderId/email/amount/productName 구조 → 전체 컬럼으로 재작성
    -->
    <resultMap id="paymentResultMap" type="dto.member.PaymentDTO">
        <id     property="id"           column="id"/>
        <result property="userId"       column="user_id"/>
        <result property="userName"     column="user_name"/>
        <result property="membershipId" column="membership_id"/>
        <result property="mrId"         column="mr_id"/>
        <result property="gymId"        column="gym_id"/>
        <result property="trainerId"    column="trainer_id"/>
        <result property="paymentDate"  column="payment_date"/>
        <result property="paymentPrice" column="payment_price"/>
        <result property="paymentFee"   column="payment_fee"/>
        <result property="method"       column="method"/>
        <result property="status"       column="status"/>
        <result property="paymentType"  column="payment_type"/>
        <result property="canceledAt"   column="canceled_at"/>
        <result property="reason"       column="reason"/>
    </resultMap>

    <!-- 결제 저장 -->
    <insert id="insert" parameterType="dto.member.PaymentDTO">
        INSERT INTO PAYMENT (
            user_id, user_name, membership_id, mr_id, gym_id, trainer_id,
            payment_date, payment_price, payment_fee, method, status, payment_type
        ) VALUES (
            #{userId}, #{userName}, #{membershipId}, #{mrId}, #{gymId}, #{trainerId},
            NOW(), #{paymentPrice}, #{paymentFee}, #{method}, #{status}, #{paymentType}
        )
    </insert>

    <!-- 결제 상태 변경 -->
    <update id="updateStatus" parameterType="map">
        UPDATE PAYMENT SET status = #{status} WHERE id = #{id}
    </update>

    <!-- 취소 처리 -->
    <update id="cancel" parameterType="map">
        UPDATE PAYMENT
        SET status     = '취소완료',
            canceled_at = NOW(),
            reason      = #{reason}
        WHERE id = #{id}
    </update>

    <!-- user_id로 결제 내역 조회 -->
    <select id="findByUserId" parameterType="int" resultMap="paymentResultMap">
        SELECT id, user_id, user_name, membership_id, mr_id, gym_id, trainer_id,
               payment_date, payment_price, payment_fee, method, status, payment_type,
               canceled_at, reason
        FROM PAYMENT
        WHERE user_id = #{userId}
        ORDER BY id DESC
    </select>

</mapper>
