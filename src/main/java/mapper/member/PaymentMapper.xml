<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.PaymentMapper">

    <resultMap id="paymentResultMap" type="dto.member.PaymentDTO">
        <id     property="orderId"     column="order_id"/>
        <result property="email"       column="email"/>
        <result property="amount"      column="amount"/>
        <result property="productName" column="product_name"/>
        <result property="status"      column="status"/>
    </resultMap>

    <!-- ──────────────────────────────────────────────────────
         PaymentDAOImpl.insert(PaymentDTO dto)
         → param: PaymentDTO
         ────────────────────────────────────────────────────── -->
    <insert id="insert" parameterType="PaymentDTO">
        INSERT INTO payment (order_id, email, amount, product_name, status)
        VALUES (#{orderId}, #{email}, #{amount}, #{productName}, #{status})
    </insert>

    <!-- ──────────────────────────────────────────────────────
         PaymentDAOImpl.updateStatus(String orderId, String status)
         → Map 키: orderId / status
         ────────────────────────────────────────────────────── -->
    <update id="updateStatus" parameterType="map">
        UPDATE payment
        SET status   = #{status}
        WHERE order_id = #{orderId}
    </update>

</mapper>