<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.CompleteMapper">

    <!-- ──────────────────────────────────────────────────────
         CompleteDAOImpl.insertLog(String userId)
         → param: string
         ────────────────────────────────────────────────────── -->
    <insert id="insertLog" parameterType="string">
        INSERT INTO complete_log (user_id, workout_date)
        VALUES (#{userId}, NOW())
    </insert>

    <!-- ──────────────────────────────────────────────────────
         CompleteDAOImpl.getWeekLog(String userId)
         → param: string, return: List<String>
         ────────────────────────────────────────────────────── -->
    <select id="getWeekLog" parameterType="string" resultType="string">
        SELECT DATE_FORMAT(workout_date, '%a') AS d
        FROM complete_log
        WHERE user_id = #{userId}
          AND YEARWEEK(workout_date) = YEARWEEK(NOW())
    </select>

    <!-- ──────────────────────────────────────────────────────
         CompleteDAOImpl.getStreak(String userId)
         → param: string, return: int
         ────────────────────────────────────────────────────── -->
    <select id="getStreak" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM complete_log
        WHERE user_id = #{userId}
    </select>

    <!-- ──────────────────────────────────────────────────────
         CompleteDAOImpl.getBestStreak(String userId)
         → param: string, return: int
         ────────────────────────────────────────────────────── -->
    <select id="getBestStreak" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM complete_log
        WHERE user_id = #{userId}
    </select>

</mapper>
