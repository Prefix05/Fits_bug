<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.FoodRecordMapper">

    <resultMap id="foodResultMap" type="FoodRecordDTO">
        <id     property="id"         column="id"/>
        <result property="email"      column="email"/>
        <result property="foodName"   column="food_name"/>
        <result property="gram"       column="gram"/>
        <result property="calorie"    column="calorie"/>
        <result property="recordDate" column="record_date"/>
    </resultMap>

    <!-- ──────────────────────────────────────────────────────
         FoodRecordDAOImpl.insert(FoodRecordDTO dto)
         → param: FoodRecordDTO
         ────────────────────────────────────────────────────── -->
    <insert id="insert" parameterType="FoodRecordDTO">
        INSERT INTO food_record (email, food_name, gram, calorie)
        VALUES (#{email}, #{foodName}, #{gram}, #{calorie})
    </insert>

    <!-- ──────────────────────────────────────────────────────
         FoodRecordDAOImpl.findByEmail(String email)
         FoodRecordDAOImpl.getRecords(String email) → findByEmail 위임
         → param: string
         ────────────────────────────────────────────────────── -->
    <select id="findByEmail" parameterType="string" resultMap="foodResultMap">
        SELECT id, email, food_name, gram, calorie, record_date
        FROM food_record
        WHERE email = #{email}
        ORDER BY record_date DESC
    </select>

</mapper>
