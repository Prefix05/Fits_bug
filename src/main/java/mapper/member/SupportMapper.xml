<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.SupportMapper">

    <resultMap id="supportResultMap" type="dto.member.SupportDTO">
        <id     property="id"        column="id"/>
        <result property="email"     column="email"/>
        <result property="type"      column="type"/>
        <result property="title"     column="title"/>
        <result property="content"   column="content"/>
        <result property="filePath"  column="file_path"/>
        <result property="status"    column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- ──────────────────────────────────────────────────────
         SupportDAOImpl.insertSupport(SupportDTO dto)
         → param: SupportDTO
         ────────────────────────────────────────────────────── -->
    <insert id="insertSupport" parameterType="SupportDTO">
        INSERT INTO support (email, type, title, content, file_path)
        VALUES (#{email}, #{type}, #{title}, #{content}, #{filePath})
    </insert>

    <!-- ──────────────────────────────────────────────────────
         SupportDAOImpl.selectByEmail(String email)
         → param: string
         ────────────────────────────────────────────────────── -->
    <select id="selectByEmail" parameterType="string" resultMap="supportResultMap">
        SELECT id, email, type, title, content, file_path, status, created_at
        FROM support
        WHERE email = #{email}
        ORDER BY id DESC
    </select>

</mapper>