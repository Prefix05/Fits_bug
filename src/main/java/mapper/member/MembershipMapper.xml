<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.MembershipMapper">

    <resultMap id="membershipResultMap" type="dto.member.MembershipDTO">
        <id     property="id"        column="id"/>
        <result property="gymId"     column="gym_id"/>
        <result property="trainerId" column="trainer_id"/>
        <result property="type"      column="type"/>
        <result property="typeRep"   column="type_rep"/>
        <result property="price"     column="price"/>
    </resultMap>

    <resultMap id="registrationResultMap" type="dto.member.MembershipRegistrationDTO">
        <id     property="id"           column="id"/>
        <result property="memberId"     column="member_id"/>
        <result property="membershipId" column="membership_id"/>
        <result property="registerDate" column="register_date"/>
        <result property="startDate"    column="start_date"/>
        <result property="endDate"      column="end_date"/>
        <result property="status"       column="status"/>
    </resultMap>

    <!-- MEMBERSHIP 조회 -->
    <select id="findById" parameterType="int" resultMap="membershipResultMap">
        SELECT id, gym_id, trainer_id, type, type_rep, price
        FROM MEMBERSHIP WHERE id = #{id}
    </select>

    <!-- GYM별 이용권 목록 -->
    <select id="findByGymId" parameterType="int" resultMap="membershipResultMap">
        SELECT id, gym_id, trainer_id, type, type_rep, price
        FROM MEMBERSHIP WHERE gym_id = #{gymId}
    </select>

    <!-- TRAINER별 이용권 목록 -->
    <select id="findByTrainerId" parameterType="int" resultMap="membershipResultMap">
        SELECT id, gym_id, trainer_id, type, type_rep, price
        FROM MEMBERSHIP WHERE trainer_id = #{trainerId}
    </select>

    <!-- MEMBERSHIP_REGISTRATION 등록 -->
    <insert id="insertRegistration" parameterType="dto.member.MembershipRegistrationDTO">
        INSERT INTO MEMBERSHIP_REGISTRATION
            (member_id, membership_id, register_date, start_date, end_date, status)
        VALUES
            (#{memberId}, #{membershipId}, #{registerDate}, #{startDate}, #{endDate}, #{status})
    </insert>

    <!-- MEMBER.id로 등록 현황 조회 -->
    <select id="findRegistrationByMemberId" parameterType="int" resultMap="registrationResultMap">
        SELECT id, member_id, membership_id, register_date, start_date, end_date, status
        FROM MEMBERSHIP_REGISTRATION
        WHERE member_id = #{memberId}
        ORDER BY id DESC
    </select>

    <!-- 상태 업데이트 (expired 처리) -->
    <update id="updateRegistrationStatus" parameterType="map">
        UPDATE MEMBERSHIP_REGISTRATION
        SET status = #{status}
        WHERE id = #{id}
    </update>

</mapper>
