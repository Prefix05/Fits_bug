<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.MembershipMapper">

    <!-- ──────────────────────────────────────────────────────
         MembershipDAOImpl.decreaseCount(String email)
         → param: string
         ────────────────────────────────────────────────────── -->
    <update id="decreaseCount" parameterType="string">
        UPDATE membership
        SET remain_count = remain_count - 1
        WHERE email = #{email}
          AND remain_count > 0
    </update>

    <!-- 멤버십 조회 (필요 시 사용) -->
    <select id="findByEmail" parameterType="string" resultType="map">
        SELECT email, product_name, total_count, remain_count,
               start_date, end_date
        FROM membership
        WHERE email = #{email}
    </select>

</mapper>