<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.MemberMapper">

    <!-- ======================================================
         ResultMap : DB 컬럼 ↔ DTO 필드 매핑
         ====================================================== -->
    <resultMap id="memberResultMap" type="dto.member.MemberDTO">
        <id     property="email"         column="email"/>
        <result property="password"      column="password"/>
        <result property="nickname"      column="nickname"/>
        <result property="phone"         column="phone"/>
        <result property="profileImage"  column="profile_image"/>
        <result property="emailVerified" column="email_verified"/>
        <result property="socialType"    column="social_type"/>
    </resultMap>

    <!-- ──────────────────────────────────────────────────────
         MemberDAOImpl.loginCheck(MemberDTO dto)
         → param: MemberDTO  (dto.getEmail(), dto.getPassword())
         ────────────────────────────────────────────────────── -->
    <select id="loginCheck" parameterType="MemberDTO" resultType="MemberDTO">
        SELECT email, password, nickname, phone, role,
               profile_image
        FROM user
        WHERE email    = #{email}
          AND password = #{password}
    </select>

    <!-- ──────────────────────────────────────────────────────
         MemberDAOImpl.findByEmail(String email)
         → param: string (단일 값)
         ────────────────────────────────────────────────────── -->
    <select id="findByEmail" parameterType="string" resultMap="memberResultMap">
        SELECT email, password, nickname, phone,
               profile_image, email_verified, social_type
        FROM member
        WHERE email = #{email}
    </select>

    <!-- ──────────────────────────────────────────────────────
         MemberDAOImpl.isEmailExists(String email)
         → param: string, return: int (COUNT)
         ────────────────────────────────────────────────────── -->
    <select id="isEmailExists" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM member WHERE email = #{email}
    </select>

    <!-- ──────────────────────────────────────────────────────
         MemberDAOImpl.getNicknameByEmail(String email)
         → param: string, return: string
         ────────────────────────────────────────────────────── -->
    <select id="getNicknameByEmail" parameterType="string" resultType="string">
        SELECT nickname FROM member WHERE email = #{email}
    </select>

    <!-- ──────────────────────────────────────────────────────
         MemberDAOImpl.insertMember(MemberDTO member)
         → param: MemberDTO
         ────────────────────────────────────────────────────── -->
    <insert id="insertMember" parameterType="MemberDTO">
        INSERT INTO member
            (email, password, nickname, phone, profile_image, email_verified, social_type)
        VALUES
            (#{email}, #{password}, #{nickname}, #{phone},
             #{profileImage}, #{emailVerified}, #{socialType})
    </insert>

    <!-- ──────────────────────────────────────────────────────
         MemberDAOImpl.insertKakaoUser(MemberDTO dto)
         → param: MemberDTO
         ────────────────────────────────────────────────────── -->
    <insert id="insertKakaoUser" parameterType="MemberDTO">
        INSERT INTO member (email, nickname, email_verified, social_type)
        VALUES (#{email}, #{nickname}, #{emailVerified}, #{socialType})
    </insert>

    <!-- ──────────────────────────────────────────────────────
         MemberDAOImpl.update(MemberDTO dto)
         MyPageDAOImpl.updateMember(MemberDTO member)
         → param: MemberDTO
         ────────────────────────────────────────────────────── -->
    <update id="update" parameterType="MemberDTO">
        UPDATE member
        SET nickname = #{nickname},
            password = #{password}
        WHERE email  = #{email}
    </update>

    <!-- ──────────────────────────────────────────────────────
         MyPageDAOImpl.updateProfileImg(MemberDTO member)
         → param: MemberDTO
         ────────────────────────────────────────────────────── -->
    <update id="updateProfileImage" parameterType="MemberDTO">
        UPDATE member
        SET profile_image = #{profileImage}
        WHERE email = #{email}
    </update>

</mapper>