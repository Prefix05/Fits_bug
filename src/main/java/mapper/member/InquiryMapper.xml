<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.InquiryMapper">

    <resultMap id="inquiryResultMap" type="dto.member.InquiryDTO">
        <id     property="id"          column="id"/>
        <result property="userId"      column="user_id"/>
        <result property="category"    column="category"/>
        <result property="title"       column="title"/>
        <result property="content"     column="content"/>
        <result property="file"        column="file"/>
        <result property="result"      column="result"/>
        <result property="status"      column="status"/>
        <result property="regDate"     column="reg_date"/>
        <result property="processDate" column="process_date"/>
    </resultMap>

    <!-- 문의 저장 -->
    <insert id="insert" parameterType="dto.member.InquiryDTO">
        INSERT INTO INQUIRY (user_id, category, title, content, file)
        VALUES (#{userId}, #{category}, #{title}, #{content}, #{file})
    </insert>

    <!-- user_id로 문의 목록 조회 -->
    <select id="findByUserId" parameterType="int" resultMap="inquiryResultMap">
        SELECT id, user_id, category, title, content, file,
               result, status, reg_date, process_date
        FROM INQUIRY
        WHERE user_id = #{userId}
        ORDER BY id DESC
    </select>

    <!-- 전체 문의 조회 (관리자용) -->
    <select id="findAll" resultMap="inquiryResultMap">
        SELECT id, user_id, category, title, content, file,
               result, status, reg_date, process_date
        FROM INQUIRY
        ORDER BY id DESC
    </select>

    <!-- 상태 + 처리결과 업데이트 -->
    <update id="updateStatus" parameterType="map">
        UPDATE INQUIRY
        SET status       = #{status},
            result       = #{result},
            process_date = NOW()
        WHERE id = #{id}
    </update>

</mapper>
