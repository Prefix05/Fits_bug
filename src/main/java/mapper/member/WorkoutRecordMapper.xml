<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.WorkoutRecordMapper">

    <!-- =========================
         1. WorkoutLog + Detail 1:N 매핑
         ========================= -->
    <resultMap id="WorkoutLogResultMap" type="dto.member.WorkoutLogDTO">

        <id property="id" column="log_id"/>

        <result property="memberId" column="member_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="gymId" column="gym_id"/>

        <result property="date" column="workout_date"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>

        <!-- 🔥 1:N 핵심 -->
        <collection property="details" ofType="dto.member.WorkoutDetailDTO">

            <id property="id" column="detail_id"/>

            <result property="workoutId" column="log_id"/>
            <result property="title" column="title"/>
            <result property="set" column="set_count"/>
            <result property="rep" column="rep_count"/>
            <result property="weight" column="weight"/>

        </collection>

    </resultMap>

    <!-- =========================
         2. 운동기록 조회 (1:N JOIN)
         ========================= -->
    <select id="selectWorkoutRecords"
            parameterType="string"
            resultMap="WorkoutLogResultMap">

        SELECT
            l.id            AS log_id,
            l.member_id,
            l.session_id,
            l.gym_id,
            l.workout_date,
            l.start_time,
            l.end_time,

            d.id            AS detail_id,
            d.workout_id,
            d.title,
            d.set_count,
            d.rep_count,
            d.weight

        FROM workout_log l
        LEFT JOIN workout_detail d
            ON l.id = d.workout_id

        WHERE l.member_id = (
            SELECT id FROM member WHERE email = #{email}
        )

        ORDER BY l.id DESC, d.id ASC

    </select>

    <!-- =========================
         3. WorkoutLog INSERT
         ========================= -->
    <insert id="insertWorkoutLog"
            parameterType="dto.member.WorkoutLogDTO"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO workout_log (
            member_id,
            session_id,
            gym_id,
            workout_date,
            start_time,
            end_time
        )
        VALUES (
            #{memberId},
            #{sessionId},
            #{gymId},
            #{date},
            #{startTime},
            #{endTime}
        )

    </insert>

    <!-- =========================
         4. WorkoutDetail INSERT
         ========================= -->
    <insert id="insertWorkoutDetail"
            parameterType="dto.member.WorkoutDetailDTO">

        INSERT INTO workout_detail (
            workout_id,
            title,
            set_count,
            rep_count,
            weight
        )
        VALUES (
            #{workoutId},
            #{title},
            #{set},
            #{rep},
            #{weight}
        )

    </insert>

</mapper>