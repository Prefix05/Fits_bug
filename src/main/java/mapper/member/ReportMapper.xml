<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.ReportMapper">

    <!-- ──────────────────────────────────────────────────────
         ReportDAOImpl.insert(ReportDTO dto)
         → param: ReportDTO
         ────────────────────────────────────────────────────── -->
    <insert id="insert" parameterType="ReportDTO">
        INSERT INTO report (post_id, reason, detail, user_id)
        VALUES (#{postId}, #{reason}, #{detail}, #{userId})
    </insert>

</mapper>