<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.InbodyRecordMapper">

    <resultMap id="inbodyResultMap" type="dto.member.InbodyRecordDTO">
        <id     property="id"         column="id"/>
        <result property="email"      column="email"/>
        <result property="weight"     column="weight"/>
        <result property="muscle"     column="muscle"/>
        <result property="fat"        column="fat"/>
        <result property="imagePath"  column="image_path"/>
        <result property="recordDate" column="record_date"/>
    </resultMap>

    <!-- ──────────────────────────────────────────────────────
         InbodyRecordDAOImpl.insert(InbodyRecordDTO dto)
         → param: InbodyRecordDTO
         ────────────────────────────────────────────────────── -->
    <insert id="insert" parameterType="InbodyRecordDTO">
        INSERT INTO inbody_record (email, weight, muscle, fat, image_path)
        VALUES (#{email}, #{weight}, #{muscle}, #{fat}, #{imagePath})
    </insert>

    <!-- ──────────────────────────────────────────────────────
         InbodyRecordDAOImpl.findByEmail(String email)
         InbodyRecordDAOImpl.getRecords(String email) → findByEmail 위임
         → param: string
         ────────────────────────────────────────────────────── -->
    <select id="findByEmail" parameterType="string" resultMap="inbodyResultMap">
        SELECT id, email, weight, muscle, fat, image_path, record_date
        FROM inbody_record
        WHERE email = #{email}
        ORDER BY record_date DESC
    </select>

</mapper>