<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="mapper.schedule">
  	<resultMap type="dto.gym.Schedule" id="scheduleMap">
  		<id property="gsNum" column="gs_num"/>
  		<result property="gymNum" column="gym_num"/>
  		<result property="availableWeekdayStart" column="available_weekday_start"/>
  		<result property="availableWeekdayEnd" column="available_weekday_end"/>
  		<result property="availableWeekendStart" column="available_weekend_start"/>
  		<result property="availableWeekendEnd" column="available_weekend_end"/>
  	</resultMap>
  	
  	<select id="selectScheduleByGym" parameterType="int" resultMap="scheduleMap">
  		SELECT
            gs_num,
            gym_num,
            available_weekday_start,
            available_weekday_end,
            available_weekend_start,
            available_weekend_end
        FROM GYM_SCHEDULE
        WHERE gym_num = #{value}
  	</select>
  </mapper>