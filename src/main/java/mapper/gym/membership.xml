<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="mapper.membership">
  	<resultMap type="dto.gym.Membership" id="membershipMap">
  		<id property="membershipNum" column="membership_num"/>
  		<result property="gymNum" column="gym_num"/>
  		<result property="typeRep" column="type_rep"/>
  	</resultMap>
  	
  	<select id="selectMembershipByGym" parameterType="int" resultMap="membershipMap">
  		SELECT
            membership_num,
            gym_num,
            type,
            type_rep,
            price
        FROM MEMBERSHIP
        WHERE gym_num = #{value}
          AND type IN ('day', 'month')
        ORDER BY
            CASE
                WHEN type = 'day' THEN 1
                WHEN type = 'month' THEN 2
            END,
            type_rep ASC
  	</select>
  </mapper>