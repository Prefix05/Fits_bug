<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lesson">

    <resultMap id="lessonMap" type="lesson">
        <id property="lessonId" column="lesson_id"/>
        <result property="goal" column="goal"/>
        <result property="memberName" column="member_name"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="durationMinutes" column="duration_minutes"/>
        <result property="status" column="status"/>
        <result property="clientId" column="client_id"/>
    </resultMap>

    <select id="findLessonsByDate" parameterType="map" resultMap="lessonMap">
        SELECT
            l.lesson_id,
            l.goal,
            l.member_name,
            l.client_id,
            l.status,
            DATE_FORMAT(l.start_time, '%H:%i') AS start_time,
            DATE_FORMAT(l.end_time, '%H:%i') AS end_time,
            TIMESTAMPDIFF(MINUTE, l.start_time, l.end_time) AS duration_minutes
        FROM lesson l
                 JOIN clients c ON l.client_id = c.client_id
        WHERE l.lesson_date = #{date}
          AND c.trainer_id = #{trainerId}
        ORDER BY l.start_time ASC
    </select>
</mapper>
