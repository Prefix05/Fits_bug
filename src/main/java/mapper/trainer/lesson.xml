<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lesson">

    <resultMap id="lessonMap" type="lesson">
        <id property="lessonId" column="lesson_id"/>
        <result property="goal" column="goal"/>
        <result property="memberName" column="member_name"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="durationMinutes" column="duration_minutes"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="findLessonsByDate" parameterType="string" resultMap="lessonMap">
        SELECT
            lesson_id,
            goal,
            member_name,
            DATE_FORMAT(start_time, '%H:%i') AS start_time,
            DATE_FORMAT(end_time, '%H:%i') AS end_time,
            TIMESTAMPDIFF(MINUTE, start_time, end_time) AS duration_minutes,
            COALESCE(status, 'Booked') AS status
        FROM lesson
        WHERE lesson_date = #{date}
        ORDER BY start_time ASC
    </select>
</mapper>
