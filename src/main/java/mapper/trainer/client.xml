<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="dao.ClientMapper">

    <resultMap id="clientResultMap" type="dto.trainer.ClientDTO">
        <id property="clientId" column="id"/>
        <result property="name" column="name"/>
        <result property="age" column="age"/>
        <result property="goals" column="goals"/>
        <result property="nextSession" column="next_session"/>
        <result property="lessonCount" column="lesson_count"/>
        <result property="totalLessons" column="total_lessons"/>
        <result property="height" column="height"/>
        <result property="weight" column="weight"/>
        <result property="lastSession" column="last_session"/>
        <result property="status" column="status"/>
        <result property="trainerId" column="trainer_id"/>

    </resultMap>

    <select id="selectClients" resultMap="clientResultMap">
        SELECT * FROM member
        <where>
            trainer_id = #{trainerId}
            <if test="filter != null and filter != 'all'">
                AND status = #{filter}
            </if>
        </where>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countClients" resultType="int">
        SELECT COUNT(*) FROM member    <where>
            trainer_id = #{trainerId}
            <if test="filter != null and filter != 'all'">
                AND status = #{filter}
            </if>
        </where>
    </select>

    <select id="selectClientById" resultMap="clientResultMap">
        SELECT *
        FROM member
        WHERE id = #{clientId}
    </select>

    <select id="selectClientByName" resultMap="clientResultMap">
        SELECT *
        FROM member
        WHERE name = #{name}
    </select>

    <select id="getClientDetail" parameterType="int" resultMap="clientResultMap">
        SELECT
            id,
            name,
            age,
            goals,
            next_session,
            lesson_count,
            total_lessons,
            height,
            weight,
            status,
            trainer_id
        FROM member
        WHERE id = #{clientId}
    </select>

</mapper>
