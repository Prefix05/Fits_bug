        <mapper resource="mapper/member/PtFeedbackMapper.xml"/>
        <mapper resource="mapper/member/ReportMapper.xml"/>
        <mapper resource="mapper/member/ReservationMapper.xml"/>
        <mapper resource="mapper/member/SupportMapper.xml"/>
        <mapper resource="mapper/member/TrainerReviewMapper.xml"/>
        <mapper resource="mapper/member/CompleteMapper.xml"/>
        <mapper resource="mapper/member/MembershipMapper.xml"/>
		<mapper resource="mapper/trainer/lesson.xml"/>
