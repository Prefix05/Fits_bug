		<mapper resource="mapper/gym/trainerManage.xml"/>
		<mapper resource="mapper/gym/trainerApprove.xml"/>
		<mapper resource="mapper/gym/sales.xml"/>
		<mapper resource="mapper/gym/infoEdit.xml"/>

		<mapper resource="mapper/gym/payment.xml"/>
		<mapper resource="mapper/member/MemberMapper.xml"/> 


		<mapper resource="mapper/member/loginMapper.xml"/>
		<mapper resource="mapper/member/MemberMapper.xml"/>
        <mapper resource="mapper/member/WorkoutPlanMapper.xml"/>
