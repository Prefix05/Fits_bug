<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
	PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
	<settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>
	<typeAliases>
		<typeAlias type="dto.admin.MemberDTO" alias="member"/>
		<typeAlias type="dto.admin.ExerciseDTO" alias="exercise"/>
		<typeAlias type="dto.admin.ReportDTO" alias="report"/>
		<typeAlias type="dto.admin.InquiryDTO" alias="inquiry"/>
		<typeAlias type="dto.admin.SalesDTO" alias="sales"/>
		<typeAlias type="dto.trainer.LessonDTO" alias="lesson"/>
		<typeAlias type="dto.trainer.NotificationDTO" alias="notification"/>
		<typeAlias type="dto.trainer.ClientDTO" alias="client"/>
		<typeAlias type="dto.trainer.MealDTO" alias="meal"/>
		<typeAlias alias="MemberDTO"        type="dto.member.MemberDTO"/>
        <typeAlias alias="WorkoutPlanDTO"   type="dto.member.WorkoutPlanDTO"/>
        <typeAlias alias="WorkoutRecordDTO" type="dto.member.WorkoutRecordDTO"/>
        <typeAlias alias="FoodRecordDTO"    type="dto.member.FoodRecordDTO"/>
        <typeAlias alias="InbodyRecordDTO"  type="dto.member.InbodyRecordDTO"/>
        <typeAlias alias="PostDTO"          type="dto.member.PostDTO"/>
        <typeAlias alias="CommentDTO"       type="dto.member.CommentDTO"/>
        <typeAlias alias="CommunityDTO"     type="dto.member.CommunityDTO"/>
        <typeAlias alias="MessageDTO"       type="dto.member.MessageDTO"/>
        <typeAlias alias="MessageRoomDTO"   type="dto.member.MessageRoomDTO"/>
        <typeAlias alias="NotificationDTO"  type="dto.member.NotificationDTO"/>
        <typeAlias alias="PaymentDTO"       type="dto.member.PaymentDTO"/>
        <typeAlias alias="PtFeedbackDTO"    type="dto.member.PtFeedbackDTO"/>
        <typeAlias alias="ReportDTO"        type="dto.member.ReportDTO"/>
        <typeAlias alias="ReservationDTO"   type="dto.member.ReservationDTO"/>
        <typeAlias alias="SupportDTO"       type="dto.member.SupportDTO"/>
        <typeAlias alias="TrainerReviewDTO" type="dto.member.TrainerReviewDTO"/>
		<typeAlias type="dto.trainer.UserDTO" alias="user"/>
		<typeAlias type="dto.gym.Gym"  alias="gym"/>
	</typeAliases>

	<environments default="development">
		<environment id="development">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<property name="driver" value="org.mariadb.jdbc.Driver"/>
				<property name="url" value="jdbc:mariadb://localhost:3306/fitsbug"/>
				<property name="username" value="root"/>
				<property name="password" value="7564"/>
<!-- 				최대 활성 커넥션 수 : 동시에 사용할 수 있는 최대 커녁센 수-->
				<property name="poolMaximumActiveConnections" value="500"/>
<!-- 				최대 유효 커넥션 수 : 사용하지않고 대기 상태를 유지할 커넥선 개수-->
				<property name="poolMaximumIdleConnections" value="500"/>
			</dataSource>
		</environment>
	</environments>

	<mappers>
		<mapper resource="mapper/admin/member.xml"/>
		<mapper resource="mapper/admin/exercise.xml"/>
		<mapper resource="mapper/admin/report.xml"/>
		<mapper resource="mapper/admin/inquiry.xml"/>
		<mapper resource="mapper/admin/sales.xml"/>
		<mapper resource="mapper/gym/gymMain.xml"/>
		<mapper resource="mapper/gym/gymNotice.xml"/>
